AMBIENTE=dev
DEBUG=true
BASE_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+psycopg://zon:zon@127.0.0.1:5432/zoneamento

# --- MODO DESENVOLVIMENTO ---
# storage em disco, servido pela rota /files da propria API.
# Task roda no processo da API: sem Redis, sem worker separado.
STORAGE_BACKEND=local
STORAGE_DIR=./.storage
CELERY_EAGER=true

# --- PRODUCAO: trocar para ---
# STORAGE_BACKEND=s3
# CELERY_EAGER=false
# REDIS_URL=redis://127.0.0.1:6379/0
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_BUCKET=zoneamento
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=zoneamento
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto

LIMIAR_CHUNK_PX=40000000
CHUNK_PX=2048
MAX_UPLOAD_MB=4096
JOB_TIMEOUT_S=3600
DIR_TRABALHO=./.tmp

JWT_SECRET=trocar-em-producao
